# Runtime: use a pooled PostgreSQL URL with certificate validation.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# Optional direct connection with migration privileges. A Neon direct endpoint
# is derived from DATABASE_URL when this is empty.
DIRECT_DATABASE_URL=
# Generate a stable random secret: openssl rand -hex 32
AUTH_SECRET=
# Production canonical origin: HTTPS, no trailing slash.
APP_ORIGIN=https://neopathshala.com
# Preview builds use Vercel's trusted VERCEL_URL automatically.
STORAGE_DRIVER=database
# Configure a verified SMTP sender. Port 587 + STARTTLS or port 465 + secure=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@neopathshala.com
# Deployed entrance app origin. Do not use localhost in production.
ENTRANCE_PORTAL_URL=https://entrance.neopathshala.com
# Optional contact links.
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=
TIKTOK_URL=
LINKEDIN_URL=
# Content and private records now use PostgreSQL in every environment.
# For one-time private-data import, set LEGACY_COMMUNITY_DIR to the extracted legacy community-data directory.

# Use the SAME server-only value in adminPortal and mainPanel for shared SMTP credentials.
PLATFORM_MAIL_KEY=

# Public entrance link bundled into the main portal.
NEXT_PUBLIC_ENTRANCE_PORTAL_URL=https://entrance.neopathshala.com

# Optional private media CDN origin (no signing secret is needed by mainPanel).
MEDIA_CDN_ORIGIN=
# Optional separate static-asset CDN; leave blank for Vercel default CDN.
NEXT_PUBLIC_STATIC_CDN_ORIGIN=

# Optional comma-separated standby Workers, using the same private R2 bucket and signing key.
MEDIA_CDN_FALLBACK_ORIGINS=

# Banner uploads are served by the admin publication-aware media gateway.
ADMIN_PORTAL_URL=https://admin.neopathshala.com

# Optional separate Upstash REST databases. Use server-only credentials.
REDIS_CACHE_NAMESPACE=main
REDIS_CATALOG_URL=
REDIS_CATALOG_TOKEN=
REDIS_PRESENTATION_URL=
REDIS_PRESENTATION_TOKEN=
REDIS_CONTENT_URL=
REDIS_CONTENT_TOKEN=
REDIS_ANALYTICS_URL=
REDIS_ANALYTICS_TOKEN=
REDIS_ENTRANCE_URL=
REDIS_ENTRANCE_TOKEN=

# Match this portal’s encryption key configured in central admin.
PLATFORM_CACHE_KEY=

# Optional short PDF aliases; leave blank during localhost-only development.
NEXT_PUBLIC_PDF_LINK_ORIGIN=
NEXT_PUBLIC_PDF_APP_ORIGIN=https://admin.neopathshala.com

# Unified opaque links for all hosted media; older PDF_LINK variables still work.
NEXT_PUBLIC_MEDIA_LINK_ORIGIN=
NEXT_PUBLIC_MEDIA_APP_ORIGIN=https://admin.neopathshala.com

# Course availability is managed in Admin → Courses → Student access.
