  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "tsc --noEmit --incremental false",
    "postinstall": "prisma generate && node scripts/pdf-worker.mjs",
