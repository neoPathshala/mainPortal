    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:security": "node scripts/test.mjs",
    "clean": "node scripts/clean.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "prisma generate",
    "deploy:check": "node scripts/check-deployment.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:setup": "node scripts/migrate.mjs && prisma generate",
    "build:webpack": "next build --webpack",
    "test": "node scripts/test.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "prestart": "node scripts/check-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs"
  },
